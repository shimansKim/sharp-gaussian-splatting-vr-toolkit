+++ b/tests/test_render_stereo.py
@@ -0,0 +1,49 @@
+import torch
+
+from sharp.cli import render_stereo
+
+
+def test_create_stereo_extrinsics_offsets_along_camera_right_axis():
+    center = torch.eye(4)
+
+    left, right = render_stereo.create_stereo_extrinsics(center, ipd_m=0.064)
+
+    left_c2w = torch.linalg.inv(left)
+    right_c2w = torch.linalg.inv(right)
+
+    assert torch.allclose(left_c2w[:3, 3], torch.tensor([-0.032, 0.0, 0.0]))
+    assert torch.allclose(right_c2w[:3, 3], torch.tensor([0.032, 0.0, 0.0]))
+
+
+def test_create_side_by_side_frame_concatenates_left_and_right_images():
+    left_color = torch.ones(2, 3, 3, dtype=torch.uint8)
+    right_color = torch.full((2, 3, 3), 2, dtype=torch.uint8)
+    left_depth = torch.ones(1, 2, 3)
+    right_depth = torch.full((1, 2, 3), 2.0)
+
+    color, depth = render_stereo.create_side_by_side_frame(
+        left_color,
+        right_color,
+        left_depth,
+        right_depth,
+    )
+
+    assert color.shape == (2, 6, 3)
+    assert depth.shape == (1, 2, 6)
+    assert torch.equal(color[:, :3, :], left_color)
+    assert torch.equal(color[:, 3:, :], right_color)
+    assert torch.equal(depth[:, :, :3], left_depth)
+    assert torch.equal(depth[:, :, 3:], right_depth)
+
+
+def test_create_trajectory_params_uses_duration_and_fps_for_frame_count():
+    params = render_stereo.create_trajectory_params(duration_seconds=4.0, fps=30.0)
+
+    assert params.num_steps == 120
+    assert params.num_repeats == 1
+
+
+def test_create_stereo_frame_filename_preserves_source_order():
+    path = render_stereo.create_stereo_frame_path("frame_000123", 7)
+
+    assert path == "000008_frame_000123.sbs.png"
