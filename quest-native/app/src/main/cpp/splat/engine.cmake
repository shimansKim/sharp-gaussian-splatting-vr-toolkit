# splat engine: pocketsplat(MIT) subset + volk + VMA + SHARP loader/camera/log as one C++20 static library.
# Used by splat/module.cmake (the app) and splat/tools/CMakeLists.txt (adb-shell GPU benchmark).
#
# Why a separate library: the app target is C++17 and links libvulkan with prototypes. pocketsplat needs
# C++20 and volk. volk is compiled with VOLK_NAMESPACE (C++), so its function pointers live in namespace
# volk and never clash with libvulkan's exported vk* symbols in the same .so.
#
#   qnsplat_add_engine(<target>)   needs qn_add_shaders() (cmake/qn_shaders.cmake) already included.

set(QNSPLAT_DIR ${CMAKE_CURRENT_LIST_DIR})
set(QNSPLAT_TP ${QNSPLAT_DIR}/third_party)
set(QNSPLAT_PS ${QNSPLAT_TP}/pocketsplat)

function(qnsplat_add_engine TARGET)
    set(shaders
        splat_chunk_cull.comp splat_prepare_indirect.comp splat_preprocess.comp splat_pick.comp
        splat_sorted_copy.comp splat.vert splat.frag radix_upsweep.comp radix_spine.comp
        radix_downsweep.comp radix_downsweep_mask.comp radix_downsweep_staged.comp)
    set(shader_paths "")
    foreach(s ${shaders})
        list(APPEND shader_paths ${QNSPLAT_PS}/render/shaders/${s})
    endforeach()
    qn_add_shaders(OUT spv TARGET_ENV vulkan1.3 FILES ${shader_paths})

    # pocketsplat includes "<name>_<ext>.spv.h" defining k_<name>_<ext>_spv[]; wrap the .spv.inc files.
    set(gen ${CMAKE_CURRENT_BINARY_DIR}/qnsplat_gen)
    file(MAKE_DIRECTORY ${gen})
    foreach(s ${shaders})
        string(REPLACE "." "_" ident ${s})
        file(WRITE ${gen}/${ident}.spv.h.tmp
            "// generated by splat/engine.cmake\n#pragma once\n#include <cstdint>\n"
            "static const std::uint32_t k_${ident}_spv[] =\n#include \"${s}.spv.inc\"\n    ;\n")
        configure_file(${gen}/${ident}.spv.h.tmp ${gen}/${ident}.spv.h COPYONLY)
    endforeach()

    add_library(${TARGET} STATIC
        ${QNSPLAT_PS}/core/src/cleaning.cpp
        ${QNSPLAT_PS}/core/src/coords.cpp
        ${QNSPLAT_PS}/core/src/pack.cpp
        ${QNSPLAT_PS}/core/src/stats.cpp
        ${QNSPLAT_PS}/render/src/radix_sort.cpp
        ${QNSPLAT_PS}/render/src/splat_renderer.cpp
        ${QNSPLAT_PS}/render/src/vk_buffer.cpp
        ${QNSPLAT_PS}/render/src/vk_context.cpp
        ${QNSPLAT_PS}/render/src/vk_descriptors.cpp
        ${QNSPLAT_PS}/render/src/vk_frame.cpp
        ${QNSPLAT_PS}/render/src/vk_pipeline.cpp
        ${QNSPLAT_PS}/render/src/vk_timer.cpp
        ${QNSPLAT_PS}/render/src/vma_impl.cpp
        ${QNSPLAT_TP}/volk/volk.c
        ${QNSPLAT_DIR}/engine/sharp_ply.cpp
        ${QNSPLAT_DIR}/engine/splat_scene.cpp
        ${QNSPLAT_DIR}/engine/xr_camera.cpp
        ${QNSPLAT_DIR}/engine/frame_log.cpp
        ${QNSPLAT_DIR}/engine/splat_engine.cpp
        ${spv})
    set_source_files_properties(${QNSPLAT_TP}/volk/volk.c PROPERTIES LANGUAGE CXX)
    set_target_properties(${TARGET} PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON POSITION_INDEPENDENT_CODE ON)
    # PRIVATE on purpose: VK_NO_PROTOTYPES must not leak into the app target (core calls vk* directly).
    target_compile_definitions(${TARGET} PRIVATE VK_NO_PROTOTYPES VOLK_NAMESPACE POCKETSPLAT_NO_VKBOOTSTRAP)
    if(ANDROID)
        target_compile_definitions(${TARGET} PRIVATE VK_USE_PLATFORM_ANDROID_KHR)
    endif()
    target_include_directories(${TARGET}
        PUBLIC ${QNSPLAT_DIR}/engine ${QNSPLAT_PS}/core/include ${QNSPLAT_PS}/render/include
               ${QNSPLAT_TP}/volk ${QNSPLAT_TP}/vma
        PRIVATE ${QNSPLAT_TP}/glm_shim ${gen} ${QN_SHADER_OUT_DIR})
    # volk.c as C++ and third-party headers: keep the build log readable.
    if(MSVC)  # PC check build only (the app is always NDK clang)
        target_compile_options(${TARGET} PRIVATE /utf-8 /W1)
        target_compile_definitions(${TARGET} PRIVATE _CRT_SECURE_NO_WARNINGS)
    else()
        target_compile_options(${TARGET} PRIVATE -Wno-nullability-completeness -Wno-unused-parameter -Wno-unused-function
                                                 -Wno-missing-field-initializers -Wno-deprecated)
    endif()
    if(ANDROID)
        target_link_libraries(${TARGET} PUBLIC log)
    endif()
endfunction()
